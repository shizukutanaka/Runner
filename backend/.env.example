# ===================================================================
# Runner バックエンド設定
# ===================================================================
#
# **ここに書かれているキーは、すべて backend/src が実際に読むものだけです。**
#
# 以前このファイルには139個のキーが並んでいましたが、そのうち **84個は
# コードのどこからも読まれていませんでした**（GDPR設定一式、サーキットブレーカー、
# アラート閾値、CSRF/2FA/セッションハイジャック検知のトグル、
# 削除済みのStripe課金20キーなど）。設定しても何も起きない項目に時間を使わせる
# 状態だったため、実在するキーだけに整理しています。
#
# E-51/E-52（2026-09-08）: 逆方向の欠落（**コードが読むのに、ここに書かれていない
# キー**）も19個見つかった（SMTP_*・SESSION_REDIS_*・BCRYPT_ROUNDS等）。
# 「ここに書いたキーが読まれること」だけでなく「コードが読むキーがここに
# 全部書かれていること」も機械検査で両方向を保証している
# （`backend/tests/services/envExample.test.js`）。
# ===================================================================

# -------------------------------------------------------------------
# 基本
# -------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_NAME="YouTube & Twitch Comment Manager"
APP_VERSION=2.1.0
DEBUG_MODE=true
LOG_LEVEL=info

# -------------------------------------------------------------------
# 秘密鍵（本番では必須。未設定だと起動を拒否します）
# 生成: openssl rand -hex 32
# -------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRY=15m
SESSION_SECRET=
ENCRYPTION_KEY=
# bcryptのコスト。未設定なら本番12・テスト環境4（NODE_ENV=testの間だけ自動で下がる）
BCRYPT_ROUNDS=

# -------------------------------------------------------------------
# セッション
# SESSION_STORE=redis にする場合は SESSION_REDIS_URL か REDIS_URL を設定
# -------------------------------------------------------------------
SESSION_STORE=memory
SESSION_NAME=runner.sid
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=strict
SESSION_COOKIE_DOMAIN=
SESSION_MAX_AGE=86400000
# セッションへのアクセスがあるたび有効期限を延長するか（既定false）
SESSION_ROLLING=false
SESSION_REDIS_URL=
SESSION_REDIS_PREFIX=runner:sess:

# -------------------------------------------------------------------
# データベース（SQLite）
# 実際のファイル位置を決めるのは DATABASE_PATH です。
# 未設定なら backend/data/comments.db が使われます。
# DATABASE_URL は sqlite: プレフィックス付きの代替指定方法（未設定でも可）
# -------------------------------------------------------------------
DATABASE_PATH=
DATABASE_URL=
DB_POOL_SIZE=5

# -------------------------------------------------------------------
# Redis（任意。セッション/レート制限を複数プロセスで共有する場合）
# -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
CACHE_TTL=300

# -------------------------------------------------------------------
# 外部API（未設定でもアプリは起動し、該当機能だけが無効になります）
# -------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MODERATION_MODEL=omni-moderation-latest

YOUTUBE_API_KEY=
# 書き戻し（メッセージ削除・BAN）にはOAuth2が必要です。APIキーだけでは読み取りのみ
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# EventSubのチャット購読にはユーザーアクセストークンが必要です（アプリトークン不可）
TWITCH_USER_ACCESS_TOKEN=
TWITCH_USER_ID=

# -------------------------------------------------------------------
# 取り込み間隔
# -------------------------------------------------------------------
YOUTUBE_POLLING_INTERVAL=5000
YOUTUBE_MAX_RESULTS=100
TWITCH_POLLING_INTERVAL=3000
TWITCH_MAX_RESULTS=50

# -------------------------------------------------------------------
# レート制限
# RATE_LIMIT_ENABLED の既定は「本番のみ有効」。明示的に true/false で上書きできます。
# 注意: ログイン保護（15分5回）は middleware/rateLimiter.js 側にあり、
# この設定に関係なく常に有効です（ブルートフォース対策のため）
# -------------------------------------------------------------------
RATE_LIMIT_ENABLED=
RATE_LIMIT_STORE=memory
# RATE_LIMIT_STORE=redis のときの接続先。未設定なら REDIS_URL、それも無ければ localhost
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_PREFIX=runner:ratelimit:
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_STRICT_MAX=20

# -------------------------------------------------------------------
# CORS / セキュリティ
# 複数オリジンを許可する場合は ALLOWED_ORIGINS にカンマ区切りで指定
# （未設定なら CORS_ORIGIN 1件のみ許可）
# -------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=
HELMET_ENABLED=true
# リバースプロキシ配下で X-Forwarded-* を信用するか（未設定はfalse）
TRUST_PROXY=false

# -------------------------------------------------------------------
# メール送信（SMTP。未設定ならログ出力のみのシミュレーションにフォールバック）
# -------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@localhost

# -------------------------------------------------------------------
# 連絡先表示（利用規約・ヘルプ画面や初期設定の既定値として使われます）
# -------------------------------------------------------------------
DEFAULT_ADMIN_EMAIL=admin@localhost
SUPPORT_EMAIL=support@localhost

# -------------------------------------------------------------------
# バックアップ（バックエンドのプロセス内でスケジュール実行されます）
# -------------------------------------------------------------------
AUTO_BACKUP=true
BACKUP_SCHEDULE=0 2 * * *
MAX_BACKUPS=30
ENCRYPT_BACKUPS=true
# 設定するとバックアップファイルをこのURL宛にも送信します（未設定ならローカル保存のみ）
REMOTE_BACKUP_URL=

# -------------------------------------------------------------------
# モデレーション
# -------------------------------------------------------------------
MODERATION_REJECTION_SCORE=60
MAX_COMMENT_LENGTH=2000

# -------------------------------------------------------------------
# 機能トグル
# -------------------------------------------------------------------
ENABLE_AI_MODERATION=true
ENABLE_REAL_TIME_SYNC=true
ENABLE_ANALYTICS=true

# -------------------------------------------------------------------
# ヘルスチェック（npm run health:check が参照）
# -------------------------------------------------------------------
MEMORY_THRESHOLD=512

# -------------------------------------------------------------------
# 開発・CI
# -------------------------------------------------------------------
# .env の未設定/プレースホルダーを起動失敗として扱うか（既定は警告のみで続行）
CHECK_ENV_STRICT=false
