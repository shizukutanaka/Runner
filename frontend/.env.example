# ===================================================================
# Runner フロントエンド設定
# ===================================================================
#
# **ここに書かれているキーは、すべて frontend/src が実際に読むものだけです。**
#
# 以前このファイルには32個のキーが並んでいましたが、そのうち **28個は
# コードのどこからも読まれていませんでした**（テーマ・タイムゾーン・
# 機能トグル・WebSocket再接続設定・CSP・2FA UI など）。
# Viteは `import.meta.env.VITE_*` で参照されたものしかバンドルに載せないため、
# 定義しただけのキーは文字通り何の効果もありません。
#
# 判定方法: 各キーを `frontend/src` 全体で検索し、参照が無いものを削除しました。
# ===================================================================

VITE_APP_VERSION=2.1.0

# -------------------------------------------------------------------
# バックエンドの場所
# -------------------------------------------------------------------
# REST API。未設定なら同一オリジンの `/api` を使います
# （nginx が /api をバックエンドへプロキシする本番構成では未設定のままで動きます）
VITE_API_BASE_URL=http://localhost:3000/api

# socket.io の接続先。コードが読むのは VITE_SOCKET_URL です
# （以前ここにあった VITE_WS_URL はどこからも参照されていませんでした）。
# socket.io はハンドシェイクをHTTPで行うため ws:// ではなく http:// を指定します。
# 未設定なら window.location.origin に接続します
VITE_SOCKET_URL=http://localhost:3000

# -------------------------------------------------------------------
# 開発用
# -------------------------------------------------------------------
# true にすると MSW（モックサーバー）を有効化します。開発時のみ有効
VITE_ENABLE_MSW=false
